ull},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthAppetiteCooldownReducer","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthAppetiteCooldownReducer","names":{"en":"SENTIENT APPETITE","zh":"灵煞食欲"},"provenance":[[0,6],[1,6]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"Helminth is able to digest all manner of miscellaneous substances, but generates a large surplus of bile in order to do so. Fortunately, this bile can be repurposed.","zh":"赫明斯巢体可以消化各种杂物，但会因此而产生过量的消化液。幸运的是，这些消化液可以再次被利用。"},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthBile","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthBile","names":{"en":"Bile","zh":"胆液块"},"provenance":[[0,7],[1,7]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"Plant-based materials of all kinds are processed and liquidized within the Helminth's digestive tract; the surplus is excreted as an inoffensive, inert clump.","zh":"各种植物类物质会在赫明斯巢体的消化道内被处理、液化，剩余的残留物则会被以无害惰性块状物的形式排出体外。"},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthBiotics","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthBiotics","names":{"en":"Biotics","zh":"微生泥"},"provenance":[[0,8],[1,8]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"On consuming minerals, Helminth converts those it does not fully absorb into a smooth, rich paste with a faint vanilla odor.","zh":"在享用矿物质时，赫明斯巢体会把那些未被完全吸收的矿物质转化为光滑浓郁、并带有淡淡香草味的糊状物。"},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthCalx","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthCalx","names":{"en":"Calx","zh":"金属垩"},"provenance":[[0,9],[1,9]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"Metallic substances, steadily corroded by the Helminth's digestive juices and exuded as a coarse powder.","zh":"金属物质，被赫明斯巢体的消化液不断腐蚀，并以大颗粒粉尘的形式分泌了出来。"},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthOxides","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthOxides","names":{"en":"Oxides","zh":"氧金属"},"provenance":[[0,10],[1,10]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"When Helminth consumes Infested matter it creates greasy intestine-like casings, bloats them with a dark, musky gas and ejects them. The reason for this is unknown and probably best left that way.","zh":"当赫明斯巢体享用了感染物质后，它会产生油腻的肠道状外壳，并通过黑色的麝香气体使其膨胀，然后将其喷射出来。这种现象的产生原因不明，可能最好不要去管它。"},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthPheromones","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthPheromones","names":{"en":"Pheromones","zh":"信息质"},"provenance":[[0,11],[1,11]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"Helminth eagerly consumes artificial materials and exudes these rope-like strands of filament as a useful byproduct.","zh":"赫明斯巢体热衷于享用人造材料，并会分泌出这些绳状的细丝，可被作为一种有用的副产品。"},"id":"/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthSynthetics","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/InfestedFoundry/HelminthSynthetics","names":{"en":"Synthetics","zh":"合成霉"},"provenance":[[0,12],[1,12]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":"Surf the Vallis with this turbo-charged K-Drive deck.","zh":"以这款配有涡轮增压器的 K 式悬浮板在山谷冲浪。"},"id":"/Lotus/StoreItems/Types/Items/SupplyDropItems/Hoverboard","key":"ClientInventorySupplyDrop|/Lotus/StoreItems/Types/Items/SupplyDropItems/Hoverboard","names":{"en":"Bondi K-Drive","zh":"邦迪 K 式悬浮板"},"provenance":[[0,13],[1,13]],"section":"ClientInventorySupplyDrop","variantSources":{"en":0,"zh":1}},{"descriptions":{"en":null,"zh":null},"id":"/Lotus/StoreItems/Types/Ite